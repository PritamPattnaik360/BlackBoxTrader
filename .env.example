# ─── Alpaca Markets ─────────────────────────────────────────────────────────────
# Get free keys at https://alpaca.markets (supports paper + live trading)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# paper = fake money (safe default), live = real money (use with caution!)
TRADING_MODE=paper

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite — no external database needed, file stored in backend/blackbox.db
USE_SQLITE=true
DATABASE_URL=sqlite+aiosqlite:///./blackbox.db

# ─── Redis ─────────────────────────────────────────────────────────────────────
# Optional — only needed for real-time WebSocket price streaming.
# Leave USE_REDIS=false to use the built-in in-memory cache (no install required).
# To enable: install Redis for Windows (https://github.com/microsoftarchive/redis/releases)
# then set USE_REDIS=true.
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# ─── News APIs ─────────────────────────────────────────────────────────────────
# NewsAPI.org — free at https://newsapi.org (100 req/day)
NEWSAPI_KEY=your_newsapi_key_here

# GNews — free fallback at https://gnews.io (100 req/day)
GNEWS_API_KEY=your_gnews_key_here

# ─── Risk Defaults (optional overrides) ────────────────────────────────────────
# RISK_PER_TRADE_PCT=0.01
# MAX_POSITION_PCT=0.10
# MAX_DRAWDOWN_HALT_PCT=0.15
# DAILY_LOSS_HALT_PCT=0.05
# MAX_OPEN_POSITIONS=20

# ─── NLP ───────────────────────────────────────────────────────────────────────
# Path where FinBERT model weights are stored (after running download_finbert.py)
FINBERT_MODEL_PATH=../data/models/finbert
