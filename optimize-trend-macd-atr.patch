index 0000000..03653cf
--- /dev/null
+++ b/backend/tests/unit/test_trend_macd_atr.py
@@ -0,0 +1,35 @@
+import numpy as np
+import pandas as pd
+
+from app.services.backtester.engine import _simulate_next_open
+from app.services.backtester.strategy import TrendMACDATRStrategy
+
+
+def _df(n=300, seed=0):
+    rng = np.random.default_rng(seed)
+    close = 100 * np.exp(np.cumsum(rng.normal(0.0004, 0.015, n)))
+    idx = pd.date_range("2020-01-01", periods=n, freq="B")
+    return pd.DataFrame({"open": close * 0.999, "high": close * 1.01, "low": close * 0.99,
+                         "close": close, "volume": 1e6}, index=idx)
+
+
+def test_signals_only_entry_in_uptrend():
+    df = _df()
+    sig = TrendMACDATRStrategy().generate_signals(df)
+    sma = df["close"].rolling(100).mean()
+    assert (df["close"][sig == 1] > sma[sig == 1]).all()
+
+
+def test_fills_at_next_open_with_costs_and_no_negative_cash():
+    df = _df()
+    sig = TrendMACDATRStrategy().generate_signals(df)
+    eq, tr = _simulate_next_open(df, sig, 10_000, 3.0)
+    assert eq.min() > 0 and not tr.empty
+    first = tr.iloc[0]
+    assert first["entry"] in set(df["open"] * 1.001)  # filled at an open plus cost
+
+
+def test_zero_signals_means_flat_equity():
+    df = _df()
+    eq, tr = _simulate_next_open(df, pd.Series(0, index=df.index), 10_000, 3.0)
+    assert tr.empty and eq.iloc[-1] == 10_000
