+def _atr(df: pd.DataFrame, n: int = 14) -> np.ndarray:
+    pc = df["close"].shift()
+    tr = pd.concat([df["high"] - df["low"], (df["high"] - pc).abs(), (df["low"] - pc).abs()], axis=1).max(axis=1)
+    return tr.rolling(n).mean().values
+
+
+def _simulate_next_open(df: pd.DataFrame, signals: pd.Series, capital: float,
+                        atr_mult: float, cost: float = COST_PER_SIDE) -> tuple[pd.Series, pd.DataFrame]:
+    """
+    Long-only simulator: signals seen at close t fill at open t+1 (no look-ahead),
+    per-side transaction cost, ATR trailing stop (stop from prior-bar ATR, intrabar low
+    trigger, gap-aware fill at min(open, stop)).
+    """
+    o, c, l = df["open"].values, df["close"].values, df["low"].values
+    a = _atr(df)
+    sig = signals.values
+    cash, pos, ep, stop, ei, pend = capital, 0, 0.0, 0.0, -1, 0
+    eq = np.full(len(df), capital, dtype=float)
+    trades = []
+
+    def close_pos(i, px):
+        nonlocal cash, pos
+        px = px * (1 - cost)
+        cash += pos * px
+        trades.append({"entry_ts": df.index[ei], "exit_ts": df.index[i], "entry": ep, "exit": px,
+                       "qty": pos, "pnl": (px - ep) * pos})
+        pos = 0
+
+    for i in range(len(df)):
+        if pend == 1 and pos == 0:
+            px = o[i] * (1 + cost)
+            sh = int(cash * 0.95 / px)
+            if sh > 0 and not np.isnan(a[i - 1]):
+                pos, ep, ei = sh, px, i
+                cash -= sh * px
+                stop = px - atr_mult * a[i - 1]
+        elif pend == -1 and pos > 0:
+            close_pos(i, o[i])
+        pend = 0
+        if pos > 0:
+            if i > ei and not np.isnan(a[i]):
+                stop = max(stop, c[i] - atr_mult * a[i])
+            if l[i] <= stop:
+                close_pos(i, min(o[i], stop))
+        if i < len(df) - 1:
+            if pos == 0 and sig[i] == 1:
+                pend = 1
+            elif pos > 0 and sig[i] == -1:
+                pend = -1
+        eq[i] = cash + pos * c[i]
+    if pos > 0:
+        close_pos(len(df) - 1, c[-1])
+        eq[-1] = cash
+    return pd.Series(eq, index=df.index), pd.DataFrame(trades)
+
+
 def _trades_to_log(trades: pd.DataFrame) -> list[dict]:
     if trades.empty:
         return []
